DB_HOST=localhost
DB_PORT=3306
DB_USER=cosmetics
DB_PASSWORD=your_password_here
DB_NAME=cosmetics_shop
JWT_SECRET=your_jwt_secret_here
PORT=3001
PAY_MODE=mock

# 域名配置（用于生成链接和二维码）
DOMAIN=https://xiaodigua.shop

# 微信小程序（邀请小程序码，可选）
WX_APPID=
WX_SECRET=

# 快递100物流查询（可选，不配置则使用模拟数据）
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=

# CORS allowed origins (comma-separated, leave empty to disable CORS)
CORS_ORIGINS=https://xiaodigua.shop
