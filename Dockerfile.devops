FROM node:18-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY devops/package.json ./
RUN npm install --omit=dev
COPY devops/src/index.js ./src/index.js
COPY devops/public ./public
# DevOps 控制台需要访问 Docker socket 和执行 docker compose 命令，
# 因此需要 root 权限（docker 组在 Alpine 中不存在）
EXPOSE 9090
CMD ["node", "./src/index.js"]
